# Linux is the deployment target: keep LF for every text file.
* text=auto eol=lf

*.py        text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
*.template  text eol=lf
*.example   text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
.gitattributes text eol=lf
.gitignore  text eol=lf
.dockerignore text eol=lf

*.png binary
*.jpg binary
*.pdf binary
*.bag binary
*.mcap binary
*.pkl binary
