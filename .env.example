# Copy to .env on the Linux host:  cp .env.example .env
# .env is git-ignored and MUST NOT be committed. Never paste a real key here.
# Priority: shell environment > .env > configs/default.yaml > built-in defaults.

# ---- runtime -------------------------------------------------------------
PASD_BACKEND=mock            # mock | mujoco | real   (mock is the only safe default)
PASD_SPLIT=dev               # dev | heldout          (heldout never writes to the library)
PASD_SEED=0
PASD_HOME=                   # empty -> ${XDG_DATA_HOME:-~/.local/share}/pasd-life-assist
# PASD_ADAPTER=sdk           # sdk (real SDK, unverified) | null (dry-run, no motion)

# ---- optional dependencies ------------------------------------------------
PASD_LLM_MODEL=
# ANTHROPIC_API_KEY=         # keep unset unless ClaudeCodePolicyGenerator is used

# ---- real hardware (Linux / SocketCAN) ------------------------------------
PASD_CAN_INTERFACE=can0
PASD_CAN_BITRATE=1000000     # verify against the AgileX PiPER manual
PASD_SERIAL_DEVICE=/dev/ttyUSB0
PASD_ALLOW_REAL=0            # set to 1 ONLY after the safety checklist in docs/08
PASD_ESTOP_ACK=0             # set to 1 ONLY when a physical e-stop is wired & tested

# ---- locale (Chinese docs / logs) ----------------------------------------
LANG=C.UTF-8
LC_ALL=C.UTF-8
PYTHONUTF8=1
